438 \u00ab \u0406\u043d\u0436\u0435\u043d\u0435\u0440\u0456\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043d\u043e\u0433\u043e \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u043d\u044f \u00bb \u0437\u0430 \u0441\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u0456\u0441\u0442\u044e F2 \u00ab \u0406\u043d\u0436\u0435\u043d\u0435\u0440\u0456\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043d\u043e\u0433\u043e \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u043d\u044f \u00bb, \u0449\u043e \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u044e\u0442\u044c \u0431\u0435\u0437\u043c\u0435\u0436\u043d\u0456 \u043c\u043e\u0436\u043b\u0438\u0432\u043e\u0441\u0442\u0456 \u0434\u043b\u044f \u043d\u0430\u0448\u0438\u0445 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0456\u0432 . \u0412\u0438\u043f\u0443\u0441\u043a\u043d\u0438\u043a\u0438 \u043d\u0430\u0448\u043e\u0457 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u0441\u0442\u0430\u044e\u0442\u044c \u0441\u043f\u0440\u0430\u0432\u0436\u043d\u0456\u043c\u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0456\u043e\u043d\u0430\u043b\u0430\u043c\u0438 \u0443 \u0441\u0432\u043e\u0454\u043c\u0443 \u043f\u043e\u043b\u0456 . \u0412\u043e\u043d\u0438 \u0437\u0434\u0430\u0442\u043d\u0456 \u0440\u043e\u0437\u0440\u043e\u0431\u043b\u044f\u0442\u0438 \u0432\u0438\u0441\u043e\u043a\u043e\u044f\u043a\u0456\u0441\u043d\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043d\u0435 \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u043d\u044f , \u043f\u0440\u043e\u0454\u043a\u0442\u0443\u0432\u0430\u0442\u0438 \u0441\u043a\u043b\u0430\u0434\u043d\u0456 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 , \u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0439 \u0432\u0434\u043e\u0441\u043a\u043e\u043d\u0430\u043b\u044e\u0432\u0430\u0442\u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043d\u0456 \u0440\u0456\u0448\u0435\u043d\u043d\u044f . \u041d\u0430\u0448\u0430 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0430 \u043d\u0430\u0434\u0430\u0454 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0430\u043c \u0433\u043b\u0438\u0431\u043e\u043a\u0456 \u0437\u043d\u0430\u043d\u043d\u044f \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0456 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f , \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0456\u0432 , \u0430\u0440\u0445\u0456\u0442\u0435\u043a\u0442\u0443\u0440\u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043d\u043e\u0433\u043e \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u043d\u044f \u0442\u0430 \u0442\u0435\u0441\u0442\u0443\u0432\u0430\u043d\u043d\u044f , \u0449\u043e \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u0454 \u0457\u043c \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u043e \u043a\u0440\u043e\u043a\u0443\u0432\u0430\u0442\u0438 \u0432 \u043c\u0430\u0439\u0431\u0443\u0442\u043d\u0454 . \u0412\u0438\u043f\u0443\u0441\u043a\u043d\u0438\u043a\u0438 \u043d\u0430\u0448\u043e\u0457 \u043e\u0441\u0432\u0456\u0442\u043d\u044c\u043e\u0457 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u043c\u043e\u0436\u0443\u0442\u044c \u0437\u043d\u0430\u0439\u0442\u0438 \u0441\u0435\u0431\u0435 \u0432 \u0440\u0456\u0437\u043d\u043e\u043c\u0430\u043d\u0456\u0442\u043d\u0438\u0445 \u0441\u0444\u0435\u0440\u0430\u0445 . \u0412\u043e\u043d\u0438 \u043c\u043e\u0436\u0443\u0442\u044c \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u044f\u043a \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043d\u043e\u0433\u043e \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u043d\u044f , \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u0456 \u0430\u043d\u0430\u043b\u0456\u0442\u0438\u043a\u0438 , \u0430\u0440\u0445\u0456\u0442\u0435\u043a\u0442\u043e\u0440\u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043d\u0438\u0445 \u0440\u0456\u0448\u0435\u043d\u044c \u0447\u0438 \u043f\u0440\u043e\u0435\u043a\u0442\u043d\u0456 \u043c\u04