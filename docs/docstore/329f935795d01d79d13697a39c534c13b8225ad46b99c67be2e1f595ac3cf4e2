n\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043e\u044e \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438 \u0456 \u0432\u043a\u0430\u0437\u0456\u0432\u043a\u0430\u043c\u0438 \u0457\u0457 \u043a\u0435\u0440\u0456\u0432\u043d\u0438\u043a\u0456\u0432;\n\n     -  \u0432\u0438\u0432\u0447\u0438\u0442\u0438  \u0456  \u0441\u0443\u0432\u043e\u0440\u043e  \u0434\u043e\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0442\u0438\u0441\u044c  \u043f\u0440\u0430\u0432\u0438\u043b  \u043e\u0445\u043e\u0440\u043e\u043d\u0438  \u043f\u0440\u0430\u0446\u0456, \n\u0442\u0435\u0445\u043d\u0456\u043a\u0438 \u0431\u0435\u0437\u043f\u0435\u043a\u0438 \u0456 \u0432\u0438\u0440\u043e\u0431\u043d\u0438\u0447\u043e\u0457 \u0441\u0430\u043d\u0456\u0442\u0430\u0440\u0456\u0457;\n\n     - \u043d\u0435\u0441\u0442\u0438 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u043b\u044c\u043d\u0456\u0441\u0442\u044c \u0437\u0430 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u0443 \u0440\u043e\u0431\u043e\u0442\u0443;\n\n     - \u0441\u0432\u043e\u0454\u0447\u0430\u0441\u043d\u043e \u0441\u043a\u043b\u0430\u0441\u0442\u0438 \u0437\u0430\u043b\u0456\u043a \u0437 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438. \n \n\n                 4. \u041f\u0406\u0414\u0412\u0415\u0414\u0415\u041d\u041d\u042f \u041f\u0406\u0414\u0421\u0423\u041c\u041a\u0406\u0412 \u041f\u0420\u0410\u041a\u0422\u0418\u041a\u0418 \n\n     4.1. \u041f\u0456\u0441\u043b\u044f \u0437\u0430\u043a\u0456\u043d\u0447\u0435\u043d\u043d\u044f \u0442\u0435\u0440\u043c\u0456\u043d\u0443 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0438 \u0437\u0432\u0456\u0442\u0443\u044e\u0442\u044c  \u043f\u0440\u043e \n\u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u0442\u0430 \u0456\u043d\u0434\u0438\u0432\u0456\u0434\u0443\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0437\u0430\u0432\u0434\u0430\u043d\u043d\u044f.\n\n     \u0417\u0430\u0433\u0430\u043b\u044