\u0456  \u043d\u0430\u0434\u0430\u044e\u0442\u044c  \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0443  \u043c\u0456\u0441\u044f\u0447\u043d\u0443  \u0432\u0456\u0434\u043f\u0443\u0441\u0442\u043a\u0443  \u0431\u0435\u0437 \n\u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f \u0437\u0430\u0440\u043e\u0431\u0456\u0442\u043d\u043e\u0457 \u043f\u043b\u0430\u0442\u0438 \u043d\u0430 \u043f\u0456\u0434\u0441\u0442\u0430\u0432\u0456 \u0434\u043e\u0432\u0456\u0434\u043e\u043a  \u0432\u0438\u0449\u0438\u0445  \u043d\u0430\u0432\u0447\u0430\u043b\u044c\u043d\u0438\u0445 \n\u0437\u0430\u043a\u043b\u0430\u0434\u0456\u0432 \u043f\u0440\u043e  \u0441\u0442\u0440\u043e\u043a  \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u043d\u043e\u0457  \u043f\u0456\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0438.  \u041d\u0430  \u043f\u0435\u0440\u0456\u043e\u0434  \u0443\u043a\u0430\u0437\u0430\u043d\u043e\u0457 \n\u0432\u0456\u0434\u043f\u0443\u0441\u0442\u043a\u0438 \u0442\u0430\u043a\u0438\u043c \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0430\u043c \u043f\u0440\u0438\u0437\u043d\u0430\u0447\u0430\u0454\u0442\u044c\u0441\u044f  \u0441\u0442\u0438\u043f\u0435\u043d\u0434\u0456\u044f  \u0432  \u0440\u043e\u0437\u043c\u0456\u0440\u0456  \u043d\u0435 \n\u043c\u0435\u043d\u0448\u0435  \u043c\u0456\u043d\u0456\u043c\u0430\u043b\u044c\u043d\u043e\u0457  \u0437\u0430\u0440\u043e\u0431\u0456\u0442\u043d\u043e\u0457  \u043f\u043b\u0430\u0442\u0438  \u0437\u0430   \u0440\u0430\u0445\u0443\u043d\u043e\u043a    \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u0438\u0445 \n\u043f\u0456\u0434\u043f\u0440\u0438\u0454\u043c\u0441\u0442\u0432, \u043e\u0440\u0433\u0430\u043d\u0456\u0437\u0430\u0446\u0456\u0439, \u0443\u0441\u0442\u0430\u043d\u043e\u0432.\n\n     5.8.  \u0423\u0441\u0456\u043c  \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0430\u043c-\u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0430\u043d\u0442\u0430\u043c  \u043d\u0430  \u043f\u0435\u0440\u0456\u043e\u0434  \u043f\u0440\u0430\