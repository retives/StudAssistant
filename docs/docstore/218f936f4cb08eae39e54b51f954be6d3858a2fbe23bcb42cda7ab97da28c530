\u0430\u043f\u0435\u043b\u044f\u0446\u0456\u0457 \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0456 \u043e\u0441\u043e\u0431\u0438 \u043d\u0430 \u0437\u0430\u0441\u0456\u0434\u0430\u043d\u043d\u044f \u0430\u043f\u0435\u043b\u044f\u0446\u0456\u0439\u043d\u043e\u0457 \u043a\u043e\u043c\u0456\u0441\u0456\u0457 \u043d\u0435 \u0434\u043e\u043f\u0443\u0441\u043a\u0430\u044e\u0442\u044c\u0441\u044f. \n\n6.5. \u041f\u0456\u0434 \u0447\u0430\u0441 \u0440\u043e\u0437\u0433\u043b\u044f\u0434\u0443 \u0430\u043f\u0435\u043b\u044f\u0446\u0456\u0457 \u0447\u043b\u0435\u043d\u0438 \u0430\u043f\u0435\u043b\u044f\u0446\u0456\u0439\u043d\u043e\u0457 \u043a\u043e\u043c\u0456\u0441\u0456\u0457 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044e\u044e\u0442\u044c \u0443\u0441\u0456 \u0441\u0432\u043e\u0457 \u0437\u0430\u0443\u0432\u0430\u0436\u0435\u043d\u043d\u044f \u0442\u0430 \u0432\u0438\u0441\u043d\u043e\u0432\u043a\u0438 \u0449\u043e\u0434\u043e \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0456\u0432 \u0432\u0438\u0437\u043d\u0430\u043d\u043d\u044f \u0442\u0430 \u043f\u0435\u0440\u0435\u0437\u0430\u0440\u0430\u0445\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u0440\u0435\u0434\u0438\u0442\u0456\u0432 \u0404\u041a\u0422\u0421. \n\n6.6. \u041f\u0456\u0441\u043b\u044f \u0437\u0430\u043a\u0456\u043d\u0447\u0435\u043d\u043d\u044f \u0437\u0430\u0441\u0456\u0434\u0430\u043d\u043d\u044f \u0430\u043f\u0435\u043b\u044f\u0446\u0456\u0439\u043d\u043e\u0457 \u043a\u043e\u043c\u0456\u0441\u0456\u0457 \u0432\u0438\u0441\u043d\u043e\u0432\u043a\u0438 \u0449\u043e\u0434\u043e \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0456\u0432 \u0432\u0438\u0437\u043d\u0430\u043d\u043d\u044f \u0442\u0430 \u043f\u0435\u0440\u0435\u0437\u0430\u0440\u0430\u0445\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u0440\u0435\u0434\u0438\u0442\u0456\u0432 \u0404\u041a\u0422\u0421 \u043f\u0456\u0434\u043f\u0438\u0441\u0443\u044e\u0442\u044c\u0441\u044f \u0432\u0441\u0456\u043c\u0430 \u0447\u043b\u0435\u043d\u0430\u043c\u0438 \u0430\u043f\u0435\u043b\u044f\u0446\u0456\u0439\u043d\u043e\u0457 \u043a\u043e\u043c\u0456\u0441\u0456\u0457, \u044f\u043a\u0456 \u043f\u0440\u0438\u0439\u043c\u0430\u043b\u0438 \u0443\u0447\u0430\u0441\u0442\u044c \u0443 \u0437\u0430\u0441\u0456\u0434\u0430\u043d\u043d\u0456. \n\n6.7. \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c \u0440\u043e\u0437\u0433\u043b\u044f\u0434\u0443 \u0430\u043f\u0435\u043b\u044f\u0446\u0456\u0457 \u0454 \u043f\u0440\u0438\u0439\u043d\u044f\u0442\u0442\u044f \u0430\u043f\u0435\u043b\u044f\u0446\u0456\u0439\u043d\u043e\u044e \u043a\u043e\u043c\u0456\u0441\u0456\u0454\u044e \u043e\u0434\u043d\u043e\u0433\u043e \u0437 \u0434\u0432\u043e\u0445 \u0440\u0456\u0448\u0435\u043d\u044c: \n\n\u2013 \u00ab\u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u0454 \u0440\u0456\u0448\u0435\u043d\u043d\u044f \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u0454 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u043c \u0432\u0438\u043c\u043e\u0433\u0430\u043c \u0442\u0430 \u043d\u0435 \u0437\u043c\u0456\u043d\u044e\u0454\u0442\u044c\u0441\u044f\u00bb; \n\n\u2013 \u00ab\u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u0454 \u0440\u0456\u0448\u0435\u043d\u043d\u044f \u043d\u0435 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u0454 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u043c \u0432\u0438\u043c\u043e\u0433\u0430\u043c \u0442\u0430 \u0437\u043c\u0456\u043d\u044e\u0454\u0442\u044c\u0441\u044f (\u0432\u043a\u0430\u0437\u0443\u0454\u0442\u044c\u0441\u044f \u043d\u043e\u0432\u0435 \u0440\u0456\u0448\u0435\u043d\u043d\u044f)\u00bb; \n\n6.8. \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0438 \u0430\u043f\u0435\u043b\u044f\u0446\u0456\u0457 \u043e\u0433\u043e\u043b\u043e\u0448\u0443\u044e\u0442\u044c\u0441\u044f \u0437\u0430\u044f\u0432\u043d\u0438\u043a\u0443 \u0432\u0456\u0434\u0440\u0430\u0437\u0443 \u043f\u0456\u0441\u043b\u044f \u0437\u0430\u043a\u0456\u043d\u0447\u0435\u043d\u043d\u044f \u0440\u043e\u0437\u0433\u043b\u044f\u0434\u0443 \u0439\u043e\u0433\u043e \u0437\u0430\u044f\u0432\u0438. \u0417\u0430\u044f\u0432\u043d\u0438\u043a\u0443 \u043f\u0440\u043e\u043f\u043e\u043d\u0443\u0454\u0442\u044c\u0441\u044f \u043f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438 \u0432\u0438\u0441\u043d\u043e\u0432\u043a\u0438 \u0430\u043f\u0435\u043b\u044f\u0446\u0456\u0439\u043d\u043e\u0457 \u043a\u043e\u043c\u0456\u0441\u0456\u0457 \u0442\u0430 \u0432\u043a\u0430\u0437\u0430\u0442\u0438 \u0432 \u043d\u0438\u0445 \u043f\u0440\u043e \u0441\u0432\u043e\u044e \u0437\u0433\u043e\u0434\u0443 \u0430\u0431\u043e \u043d\u0435\u0437\u0433\u043e\u0434\u0443 \u0437 \u0440\u0456\u0448\u0435\u043d\u043d\u044f\u043c \u0430\u043f\u0435\u043b\u044f\u0446\u0456\u0439\u043d\u043e\u0457 \u043a\u043e\u043c\u0456\u0441\u0456\u0457. \n\n6.9. \u0423 \u0440\u0430\u0437\u0456 \u0432\u0456\u0434\u0441\u0443\u0442\u043d\u043e\u0441\u0442\u0456 \u0437\u0430\u044f\u0432\u043d\u0438\u043a\u0430 \u043d\u0430 \u0437\u0430\u0441\u0456\u0434\u0430\u043d\u043d\u0456 \u0430\u043f\u0435\u043b\u044f\u0446\u0456\u0439\u043d\u043e\u0457 \u043a\u043e\u043c\u0456\u0441\u0456\u0457, \u0430\u0431\u043e \u044f\u043a\u0449\u043e \u0437\u0430\u044f\u0432\u043d\u0438\u043a \u043d\u0435 \u043f\u043e\u0433\u043e\u0434\u0436\u0443\u0454\u0442\u044c\u0441\u044f \u0437 \u0440\u0456\u0448\u0435\u043d\u043d\u044f\u043c \u0430\u043f\u0435\u043b\u044f\u0446\u0456\u0439\u043d\u043e\u0457 \u043a\u043e\u043c\u0456\u0441\u0456\u0457 \u0456 \u043d\u0435 \u043f\u0456\u0434\u043f\u0438\u0441\u0443\u0454 \u0432\u0438\u0441\u043d\u043e\u0432\u043a\u0456\u0432 \u0430\u043f\u0435\u043b\u044f\u0446\u0456\u0439\u043d\u043e\u0457 \u043a\u043e\u043c\u0456\u0441\u0456\u0457, \u0433\u043e\u043b\u043e\u0432\u0430 \u0430\u043f\u0435\u043b\u044f\u0446\u0456\u0439\u043d\u043e\u0457 \u043a\u043e\u043c\u0456\u0441\u0456\u0457 \u0437\u0434\u0456\u0439\u0441\u043d\u044e\u0454 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 \u0443 \u0432\u0438\u0441\u043d\u043e\u0432\u043a\u0430\u0445 \u0430\u043f\u0435\u043b\u044f\u0446\u0456\u0439\u043d\u043e\u0457 \u043a\u043e\u043c\u0456\u0441\u0456\u0457. \n\n6.10. \u042f\u043a\u0449\u043e \u0432 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0456 \u0440\u043e\u0437\u0433\u043b\u044f\u0434\u0443 \u0430\u043f\u0435\u043b\u044f\u0446\u0456\u0457 \u0430\u043f\u0435\u043b\u044f\u0446\u0456\u0439\u043d\u0430 \u043a\u043e\u043c\u0456\u0441\u0456\u044f \u043f\u0440\u0438\u0439\u043c\u0430\u0454 \u0440\u0456\u0448\u0435\u043d\u043d\u044f \u043f\u0440\u043e \u0437\u043c\u0456\u043d\u0443 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0456\u0432 \u0432\u0438\u0437\u043d\u0430\u043d\u043d\u044f \u0442\u0430 \u043f\u0435\u0440\u0435\u0437\u0430\u0440\u0430\u0445\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u0440\u0435\u0434\u0438\u0442\u0456\u0432 \u0404\u041a\u0422\u0421, \u0432\u043d\u043e\u0441\u044f\u0442\u044c\u0441\u044f \u0437\u043c\u0456\u043d\u0438 \u0434\u043e \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0443 \u0437 \u0432\u0438\u0437\u043d\u0430\u043d\u043d\u044f \u0442\u0430 \u043f\u0435\u0440\u0435\u0437\u0430\u0440\u0430\u0445\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u0440\u0435\u0434\u0438\u0442\u0456\u0432 \u0404\u041a\u0422\u0421.\n\n\n\n7. \u041f\u0440\u0438\u043d\u0446\u0438\u043f\u0438 \u0434\u0456\u044f\u043b\u044c\u043d\u043e\u0441\u0442\u0456 \u0443\u043d\u0456\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0443\n\n7.1. \u0412 \u0441\u0432\u043e\u0457\u0439 \u0440\u043e\u0431\u043e\u0442\u0456 \u0443\u043d\u0456\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u043a\u0435\u0440\u0443\u0454\u0442\u044c\u0441\u044f \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430\u043c\u0438, \u044f\u043a\u0456 \u0432\u0438\u043a\u043b\u0430\u0434\u0435\u043d\u0456 \u0432 \u0434\u0430\u043d\u043e\u043c\u0443 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u0456