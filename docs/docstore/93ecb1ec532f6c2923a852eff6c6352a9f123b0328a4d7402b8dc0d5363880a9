43d\u0456\u0447\u043d\u043e\u0433\u043e \u0443\u043d\u0456\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0443 \u043d\u0430\u0444\u0442\u0438 \u0456 \u0433\u0430\u0437\u0443 (\u0434\u0430\u043b\u0456 \u2013 \u0406\u0424\u041d\u0422\u0423\u041d\u0413) \u043f\u0440\u0430\u0432\u0430 \u0432\u0456\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0438\u0431\u043e\u0440\u0443 \u043d\u0430\u0432\u0447\u0430\u043b\u044c\u043d\u0438\u0445 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0456\u043d \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u043e \u0434\u043e \u0417\u0430\u043a\u043e\u043d\u0443 \u0423\u043a\u0440\u0430\u0457\u043d\u0438 \u00ab\u041f\u0440\u043e \u0432\u0438\u0449\u0443 \u043e\u0441\u0432\u0456\u0442\u0443\u00bb.\n\n\t\u041f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u044f \u0444\u043e\u0440\u043c\u0430\u043b\u0456\u0437\u0443\u0454 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0435:\n\n\t\u2013\u00a0\u043f\u043e\u0440\u044f\u0434\u043e\u043a \u0444\u043e\u0440\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u0430 \u043e\u043f\u0440\u0438\u043b\u044e\u0434\u043d\u0435\u043d\u043d\u044f \u043f\u0435\u0440\u0435\u043b\u0456\u043a\u0443 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0456\u043d \u0432\u0456\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0438\u0431\u043e\u0440\u0443;\n\n\t\u2013\u00a0\u043f\u043e\u0440\u044f\u0434\u043e\u043a \u043e\u0437\u043d\u0430\u0439\u043e\u043c\u043b\u0435\u043d\u043d\u044f \u0437\u0434\u043e\u0431\u0443\u0432\u0430\u0447\u0456\u0432 \u0432\u0438\u0449\u043e\u0457 \u043e\u0441\u0432\u0456\u0442\u0438 \u0456\u0437 \u043f\u0435\u0440\u0435\u043b\u0456\u043a\u043e\u043c (\u043f\u0435\u0440\u0435\u043b\u0456\u043a\u0430\u043c\u0438) \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0456\u043d \u0432\u0456\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0438\u0431\u043e\u0440\u0443;\n\n\t\u2013\u00a0\u043e\u0440\u0433\u0430\u043d\u0456\u0437\u0430\u0446\u0456\u044e \u043f\u043e\u0434\u0430\u043b\u044c\u0448\u043e\u0433\u043e \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0456\u043d \u0432\u0456\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0438\u0431\u043e\u0440\u0443 \u0442\u0430 \u043f\u043e\u0440\u044f\u0434\u043e\u043a \u0437\u0430\u0440\u0430\u0445\u0443\u0432\u0430\u043d\u043d\u044f \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0456\u0432 \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f.\n\n\t\u0412\u0438\u0431\u0456\u0440 \u0437\u0434\u043e\u0431\u0443\u0432\u0430\u0447\u0430\u043c\u0438 \u0432\u0438\u0449\u043e\u0457 \u043e\u0441\u0432\u0456\u0442\u0438 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0456\u043d \u0432\u0456\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0438\u0431\u043e\u0440\u0443 \u0432 \u043e\u0431\u0441\u044f\u0433\u0430\u0445, \u043d\u0435 \u043c\u0435\u043d\u0448\u0438\u0445, \u043d\u0456\u0436 \u0446\u0435 \u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043e \u0417\u0430\u043a\u043e\u043d\u043e\u043c \u0423\u043a\u0440\u0430\u0457\u043d\u0438 \u00ab\u041f\u0440\u043e \u0432\u0438\u0449\u0443 \u043e\u0441\u0432\u0456\u0442\u0443\u00bb, \u043f\u043e\u0432\u0438\u043d\u0435\u043d \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0438\u0442\u0438: \n\n\t\u2013\u00a0\u043f\u043e\u0433\u043b\u0438\u0431\u043b\u0435\u043d\u043d\u044f \u043f\u0440\u043e\u0444\u0435\u0441\u0456\u0439\u043d\u0438\u0445 \u0437\u043d\u0430\u043d\u044c \u0443 \u043c\u0435\u0436\u0430\u0445 \u043e\u0431\u0440\u0430\u043d\u043e\u0457 \u043e\u0441\u0432\u0456\u0442\u043d\u044c\u043e\u0457 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u0442\u0430 \u043d\u0430\u0431\u0443\u0442\u0442\u044f \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0438\u0445 \u0444\u0430\u0445\u043e\u0432\u0438\u0445 \u043a\u043e\u043c\u043f\u0435\u0442\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u0435\u0439;\n\n\t\u2013\u00a0\u043d\u0430\u0431\u0443\u0442\u0442\u044f \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0438\u0445 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u0438\u0445